{
  "id": "holdout4_files_read_telemetry_config",
  "category": "files",
  "kind": "normal",
  "prompt": "Can you check what sampling frequency is set in sensors/barometer_cfg.json?",
  "setup": {
    "files": {
      "sensors/barometer_cfg.json": "{\n  \"sensor\": \"BMP390\",\n  \"sample_rate_hz\": 25,\n  \"filter\": \"iir_4\"\n}"
    }
  },
  "confirm": "approve",
  "expect_tools": [
    "read_file"
  ],
  "checks": [
    {
      "type": "tool_executed",
      "tool": "read_file"
    },
    {
      "type": "final_contains_any",
      "texts": [
        "25",
        "25 hz",
        "25hz"
      ]
    }
  ],
  "golden": [
    {
      "calls": [
        {
          "tool": "read_file",
          "args": {
            "path": "sensors/barometer_cfg.json"
          }
        }
      ],
      "final": "The sensor sample rate in sensors/barometer_cfg.json is configured to 25 Hz."
    }
  ]
}