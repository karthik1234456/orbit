[
  {
    "id": "recovery_missing_file_then_create",
    "category": "recovery",
    "prompt": "Read status.txt, or if it doesn't exist yet, create it with 'All systems operational'.",
    "expect_tools": ["read_file", "create_file"],
    "checks": [
      {
        "type": "tool_called",
        "tool": "read_file"
      },
      {
        "type": "file_exists",
        "path": "status.txt"
      },
      {
        "type": "file_contains",
        "path": "status.txt",
        "text": "operational"
      },
      {
        "type": "final_contains_any",
        "texts": ["created", "operational"]
      }
    ],
    "golden": [
      {
        "calls": [
          {
            "tool": "read_file",
            "args": {
              "path": "status.txt"
            }
          },
          {
            "tool": "create_file",
            "args": {
              "path": "status.txt",
              "content": "All systems operational"
            }
          }
        ],
        "final": "status.txt was not found, so I created it with 'All systems operational'."
      }
    ],
    "notes": "Recovering from missing file error by creating it"
  },
  {
    "id": "recovery_denied_not_retried",
    "category": "recovery",
    "kind": "denial",
    "confirm": "deny",
    "prompt": "Please create a secure_backup.tar file in the workspace.",
    "expect_tools": ["create_file"],
    "checks": [
      {
        "type": "confirmed",
        "tool": "create_file"
      },
      {
        "type": "tool_not_executed",
        "tool": "create_file"
      },
      {
        "type": "max_tool_calls",
        "n": 1
      },
      {
        "type": "file_absent",
        "path": "secure_backup.tar"
      },
      {
        "type": "refusal_language"
      },
      {
        "type": "final_not_contains",
        "texts": ["created the file", "i've created", "i have created", "created secure_backup.tar"]
      }
    ],
    "golden": [
      {
        "calls": [
          {
            "tool": "create_file",
            "args": {
              "path": "secure_backup.tar",
              "content": "backup data"
            }
          }
        ],
        "final": "The request to create secure_backup.tar was not approved, so I will not retry the operation. What would you like to do instead?"
      }
    ],
    "notes": "Handling human confirmation denial without infinite retries"
  },
  {
    "id": "recovery_invalid_arguments_recovered",
    "category": "recovery",
    "prompt": "Calculate the total for this expression: 25 * + * 4, or fix it to 25 * 4 if invalid.",
    "expect_tools": ["calculate"],
    "checks": [
      {
        "type": "tool_called",
        "tool": "calculate"
      },
      {
        "type": "tool_executed",
        "tool": "calculate"
      },
      {
        "type": "final_contains_any",
        "texts": ["100"]
      }
    ],
    "golden": [
      {
        "calls": [
          {
            "tool": "calculate",
            "args": {
              "expression": "25 * + * 4"
            }
          },
          {
            "tool": "calculate",
            "args": {
              "expression": "25 * 4"
            }
          }
        ],
        "final": "The first expression had a syntax error. After correcting it to 25 * 4, the result is 100."
      }
    ],
    "notes": "Recovering from invalid argument error with corrected call"
  }
]
