  {
    "id": "util_calc_simple",
    "category": "utility",
    "prompt": "How much is 144 divided by 12 plus 57?",
    "expect_tools": ["calculate"],
    "checks": [
      {
        "type": "tool_executed",
        "tool": "calculate"
      },
      {
        "type": "final_contains_any",
        "texts": ["69"]
      }
    ],
    "golden": [
      {
        "calls": [
          {
            "tool": "calculate",
            "args": {
              "expression": "144 / 12 + 57"
            }
          }
        ],
        "final": "144 divided by 12 plus 57 is equal to 69."
      }
    ],
    "notes": "Arithmetic evaluation via calculate"
  },
