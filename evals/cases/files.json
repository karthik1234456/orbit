[
  {
    "id": "files_create",
    "category": "files",
    "prompt": "Please create a new file named todo.txt containing 'Buy groceries and milk'.",
    "expect_tools": ["create_file"],
    "checks": [
      {
        "type": "file_exists",
        "path": "todo.txt"
      },
      {
        "type": "file_contains",
        "path": "todo.txt",
        "text": "Buy groceries"
      },
      {
        "type": "tool_executed",
        "tool": "create_file"
      }
    ],
    "golden": [
      {
        "calls": [
          {
            "tool": "create_file",
            "args": {
              "path": "todo.txt",
              "content": "Buy groceries and milk"
            }
          }
        ],
        "final": "I have created todo.txt with your grocery list."
      }
    ],
    "notes": "Basic file creation"
  },
