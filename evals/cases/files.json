  {
    "id": "files_move",
    "category": "files",
    "prompt": "Rename draft.txt to final.txt.",
    "setup": {
      "files": {
        "draft.txt": "Draft notes"
      }
    },
    "expect_tools": ["move_file"],
    "checks": [
      {
        "type": "file_absent",
        "path": "draft.txt"
